# LLM configuration (OpenAI-compatible API)
# Copy this file to `.env` and fill in your key. Never commit `.env`.
LLM_API_KEY=your-api-key

# Model name. Defaults to OpenAI gpt-4o-mini.
LLM_MODEL=gpt-4o-mini

# Optional: point at any OpenAI-compatible endpoint.
# Local Ollama example:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1
LLM_BASE_URL=

# Determinism / reliability tuning
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# Logging: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
